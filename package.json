{
  "name": "acme-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w @acme/api",
    "dev:erp": "npm run dev -w @acme/erp",
    "dev:web": "npm run dev -w @acme/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:api-types": "npm run generate:openapi -w @acme/api && npm run generate -w @acme/api-types"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "@nestjs/cli": {
      "typescript": "^6.0.3"
    }
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "prisma@6.19.3": true,
    "sharp@0.35.5": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf": false
  }
}
