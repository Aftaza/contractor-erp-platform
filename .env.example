# .env.example — Fase 4 WP-51 (master §8.2). Dibaca `docker-compose.yml`.
#
# Salin ke `.env` di direktori ini dan isi nilai ASLI. `.env` TAK DI-COMMIT.
# File ini tak boleh memuat satu pun rahasia sungguhan — semua di bawah
# placeholder.
#
#   cp .env.example .env
#   podman compose config     # validasi
#   podman compose up -d
#
# Catatan: ini env untuk COMPOSE (stack production). Env development lokal
# terpisah: `.env.local` (web) dan `acme-backend/.env` (backend).

# ---- Postgres (service `db`) ----
POSTGRES_USER=postgres
# Generate baru, jangan pakai ulang password lama: openssl rand -base64 24
POSTGRES_PASSWORD=ganti-dengan-password-acak
POSTGRES_DB=acme

# ---- JWT (service `api`) ----
# WAJIB minimal 16 karakter dan BERBEDA satu sama lain.
# Generate: openssl rand -base64 32
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-minimal-16-karakter
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain-minimal-16-karakter

# ---- Hostname (service `proxy`) ----
# Di VPS: domain sungguhan, dan Caddy mengambil sertifikat Let's Encrypt
# otomatis. Default *.localhost membuat Caddy pakai TLS internal (self-signed)
# — cocok untuk mesin dev, dan itulah alasan `podman compose config` jalan
# tanpa file .env sama sekali.
WEB_DOMAIN=web.localhost
SITE_DOMAIN=site.localhost
API_DOMAIN=api.localhost
# Email ACME — hanya dipakai kalau domain di atas domain publik sungguhan.
ACME_EMAIL=admin@example.com

# ---- Situs publik (service `site`) ----
# Origin tempat gambar upload dirender di BROWSER pengunjung. Harus domain
# yang bisa dijangkau klien (biasanya https://$API_DOMAIN), bukan nama
# service internal `api`.
PUBLIC_UPLOADS_ORIGIN=http://localhost:8080

# ---- Backup (service `backup`) ----
BACKUP_RETENTION_DAYS=7

# ---- Smoke test lokal (service `proxy`) ----
# Port HOST untuk blok :8080 Caddyfile. Geser kalau 8080 sudah dipakai proses
# lain di mesin ini; port di DALAM container tetap 8080.
SMOKE_HTTP_PORT=8080

# ---- Produksi / staging (deploy/compose.prod.yml, compose.staging.yml) ----
# Placeholder <owner>/<domain> = B-001. Domain hanya dipakai di dashboard Cloudflare Tunnel.
GHCR_OWNER=<owner>
IMAGE_TAG=<sha-commit>
APP_DB_PASSWORD=ganti-password-acak-role-acme_app
MIGRATE_DB_PASSWORD=ganti-password-acak-role-acme_migrate
TUNNEL_TOKEN=ganti-token-cloudflare-tunnel
# Dipakai langkah migrasi (jangan masuk env service api): password harus URL-safe, sama dengan MIGRATE_DB_PASSWORD.
MIGRATE_DATABASE_URL=postgresql://acme_migrate:GANTI@db:5432/acme?schema=public
