# deploy/Caddyfile.prod — produksi (acme) & staging (acme-staging). SRS §2.6 INF-1/2/7/8.
# Masuk hanya lewat cloudflared (HTTP, tanpa TLS/ACME); tak ada port publik.
# Satu-satunya hop tepercaya = cloudflared (R-008): header CF-Connecting-IP dari
# peer lain diabaikan, lalu snippet `erp` menimpa header ke API dengan {client_ip}.
{
	auto_https off
	servers {
		trusted_proxies static {$CLOUDFLARED_IP}
		client_ip_headers CF-Connecting-IP
	}
}

import /etc/caddy/common.caddy

:80 {
	respond /healthz 200
	import erp
}
