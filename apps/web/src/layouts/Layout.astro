---
import { getImage } from 'astro:assets';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import logoImg from '../assets/logo.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PT Acme Konstruksi',
  description = 'Kontraktor mekanikal, sipil, elektrikal & supplier berpengalaman sejak 2017.',
} = Astro.props;

const currentPath = Astro.url.pathname;
const logo = await getImage({ src: logoImg, height: 40, format: 'webp' });
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar client:load currentPath={currentPath} logoSrc={logo.src} />
    <main>
      <slot />
    </main>
    <Footer />
      <script>
      // Animasi masuk-layar (DESIGN §Motion): tambahan setelah JS jalan; tanpa JS konten tetap terlihat.
      import { animate, inView } from 'motion';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Hanya elemen di bawah layar pertama (LCP: layar pertama tak dianimasikan).
        const below = [...document.querySelectorAll('[data-reveal]')].filter(
          (el) => el.getBoundingClientRect().top >= innerHeight,
        );
        inView(below, (el) => {
          animate(el, { opacity: [0, 1], y: [12, 0] }, { duration: 0.35 });
        });
      }
    </script>
  </body>
</html>
