---
import { Building2, Link, MapPin, Phone, Mail } from '@lucide/astro';
---

<footer class="bg-[#0f172a] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Company Info -->
      <div>
        <div class="flex items-center gap-2.5 mb-5">
          <div class="w-9 h-9 bg-[#CC0000] rounded-lg flex items-center justify-center">
            <Building2 class="w-5 h-5 text-white" />
          </div>
          <span style="font-size:20px;font-weight:800">Acme</span>
        </div>
        <p class="text-slate-400 mb-6" style="font-size:14px;line-height:1.8">
          Kontraktor mekanikal, sipil, elektrikal & supplier yang berkomitmen menghadirkan
          karya konstruksi berkualitas sejak 2017.
        </p>
        <a
          href="https://example.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-xl hover:bg-[#CC0000] hover:border-[#CC0000] transition-all duration-300 text-slate-400 hover:text-white"
          style="font-size:13px;font-weight:500"
        >
          <Link class="w-4 h-4 shrink-0" />
          direktori kontraktor
        </a>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-5" style="font-size:16px;font-weight:700">Tautan</h4>
        <div class="space-y-3">
          <a href="/" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Beranda</a>
          <a href="/tentang" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Tentang Kami</a>
          <a href="/layanan" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Layanan</a>
          <a href="/portofolio" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Portofolio</a>
          <a href="/kontak" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Kontak</a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="mb-5" style="font-size:16px;font-weight:700">Layanan</h4>
        <div class="space-y-3">
          <a href="/layanan" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Instalasi Mekanikal</a>
          <a href="/layanan" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Konstruksi Gedung &amp; Sipil</a>
          <a href="/layanan" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Instalasi Tenaga Listrik</a>
          <a href="/layanan" class="block text-slate-400 hover:text-white hover:translate-x-1 transition-all duration-200" style="font-size:14px">Fabrikasi &amp; Supplier</a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="mb-5" style="font-size:16px;font-weight:700">Kontak</h4>
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-[#CC0000]/10 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <MapPin class="w-4 h-4 text-[#A7AEB5]" />
            </div>
            <p class="text-slate-400" style="font-size:14px;line-height:1.6">Jl. Contoh Raya No. 1, Surabaya</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-[#CC0000]/10 rounded-lg flex items-center justify-center shrink-0">
              <Phone class="w-4 h-4 text-[#A7AEB5]" />
            </div>
            <p class="text-slate-400" style="font-size:14px">+62 800 0000 0001</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-[#CC0000]/10 rounded-lg flex items-center justify-center shrink-0">
              <Mail class="w-4 h-4 text-[#A7AEB5]" />
            </div>
            <p class="text-slate-400" style="font-size:14px">info@acme.example</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-slate-500" style="font-size:13px">&copy; 2026 PT Acme Konstruksi. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="#" class="text-slate-500 hover:text-slate-300 transition-colors" style="font-size:13px">Privacy Policy</a>
        <a href="#" class="text-slate-500 hover:text-slate-300 transition-colors" style="font-size:13px">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
