# acme-backend/.env.example
# Salin ke .env dan isi nilai asli. JANGAN commit .env (sudah di .gitignore).
# Semua variabel di bawah WAJIB ada — boot GAGAL (fail-fast) kalau kosong/invalid,
# bukan meledak di request pertama. Lihat src/config/env.validation.ts.

# Koneksi Postgres (dipakai Prisma — lihat prisma/schema.prisma). Wajib diawali postgresql://
DATABASE_URL=postgresql://user:password@localhost:5432/acme?schema=public

# Secret JWT — generate acak, minimal 16 karakter, BEDA antara access & refresh.
# Contoh generate: openssl rand -base64 32
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-minimal-16-karakter
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain-minimal-16-karakter

# development | production | test
NODE_ENV=development

# Port HTTP backend (service internal Docker: api:3001 — lihat master §8.2)
PORT=3001

# Opsional (SEC-1): IP soket proxy internal yang dipercaya (dipisah koma, exact
# match — mis. IP container Caddy). Hanya dari IP ini `CF-Connecting-IP` /
# `X-Forwarded-For` dipakai sebagai IP klien (throttle login + audit).
# Kosong = tak ada proxy dipercaya → semua klien tampak ber-IP proxy.
AUDIT_TRUSTED_PROXY_IPS=
